    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@opendicewar/ai": "workspace:*",
    "@opendicewar/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
