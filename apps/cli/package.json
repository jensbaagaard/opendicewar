{
  "name": "@opendicewar/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "opendicewar": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "tournament": "tsx src/tournament.ts",
